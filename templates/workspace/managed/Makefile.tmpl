# Chrome extension workspace — generated by `tabmill settings init` (tool code lives in tabmill).
# All Node work runs in the builder docker (tabmill ADR-0003); never install Node on the host.
#
# From the host:   make in-docker-<target>     (e.g. make in-docker-build)
#                  make buildsh                 (interactive shell in the container)
# Inside docker:   make deps | build | test | lint | typecheck | zip | dev EXT=<slug>

BUILDER_PATH ?= {{builder_rel}}
STACK := react

ifeq ($(wildcard $(BUILDER_PATH)/Makefile),)
$(error Builder Makefile not found at $(BUILDER_PATH). Set BUILDER_PATH=<path to builder repo>)
endif

include $(BUILDER_PATH)/Makefile

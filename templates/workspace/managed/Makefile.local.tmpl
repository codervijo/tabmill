# Makefile.local — generated by `tabmill init` from tabmill/templates/workspace (ADR-0005).
# Adapts the builder's react stack to WXT extensions in a pnpm workspace that links
# tabmill's packages (ADR-0006/0007). Edit the template in tabmill, not this copy.
# Expect make's "overriding recipe" warnings: that is the builder's override mechanism.

# --- container (consumed by the builder's buildsh / dev_container.sh) -------------------
# `:=` not `?=`: these are exported by the tool repo's Makefile too, and an inherited value
# (e.g. CONTAINER_NAME=tabmill-tool) must not redirect this workspace's container. A
# command-line `make VAR=...` still overrides.
CONTAINER_NAME := tabmill-ext
DOCKER_CMD := docker
# Mount the common parent so tabmill ({{tool_in_mount}}) is visible next to the workspace.
VOLUME_MOUNT := {{mount_root}}:/usr/src/app/
# WXT dev server port, forwarded so host Chrome can reach HMR.
HOST_PORT := 3000
CONTAINER_PORT := 3000
export CONTAINER_NAME DOCKER_CMD VOLUME_MOUNT HOST_PORT CONTAINER_PORT

CONTAINER_WS := /usr/src/app/{{workspace_in_mount}}
# The container runs as root; hand files it creates in the mount back to the host user.
HOST_UID := $(shell id -u)
HOST_GID := $(shell id -g)
OWNED_PATHS := node_modules pnpm-lock.yaml extensions /usr/src/app/{{tool_in_mount}}/packages
EXT ?=
URL ?=
DEV ?=
# Interactive targets (try, dev) need a TTY so Ctrl-C reaches the process in the container.
DOCKER_TTY := $(shell [ -t 0 ] && echo -it)

.PHONY: in-docker-% require-docker deps build test smoke try lint typecheck zip dev

# Run any target below inside the builder container, non-interactively, from the host.
in-docker-%:
	@if [ -f /.dockerenv ]; then $(MAKE) $*; exit $$?; fi
	@DOCKERFILE_PATH="$(BUILDER_PATH)" DOCKERFILE_NAME="Dockerfile.$(STACK)" \
		bash "$(BUILDER_PATH)/dev_container.sh" start >/dev/null
	@$(DOCKER_CMD) exec $(DOCKER_TTY) $(CONTAINER_NAME) bash -lc \
		'source "$$NVM_DIR/nvm.sh" && cd "$(CONTAINER_WS)" && make $* EXT="$(EXT)" URL="$(URL)" DEV="$(DEV)"; rc=$$?; \
		 chown -R $(HOST_UID):$(HOST_GID) $(OWNED_PATHS) 2>/dev/null; exit $$rc'

# Node never runs on the host.
require-docker:
	@if [ ! -f /.dockerenv ]; then \
		echo "✗ Node targets run only in the builder container — use: make in-docker-$(MAKECMDGOALS)"; \
		exit 1; \
	fi

# Package store lives inside the container, never on the bind-mounted host tree.
deps: require-docker
	@pnpm install --store-dir /root/.pnpm-store --config.confirmModulesPurge=false
	@echo "✓ Dependencies installed"

build: deps
	@pnpm -r --filter "./extensions/$(or $(EXT),*)" build
	@echo "✓ Build complete"

test: deps
	@pnpm -r --if-present --filter "./extensions/$(or $(EXT),*)" test
	@echo "✓ Tests complete"

# Playwright's bundled Chromium is installed inside the container only (never on the host).
smoke: build
	@pnpm --filter "./extensions/$(or $(EXT),*)" exec playwright install --with-deps --no-shell chromium
	@pnpm -r --if-present --filter "./extensions/$(or $(EXT),*)" smoke
	@echo "✓ Smoke tests complete"

# Manual testing: headed Chromium in the container, window on the host via X11 (v1.F).
TRY_PROFILE = /root/.tabmill-try/$(EXT)
try: deps
	@if [ -z "$(EXT)" ]; then echo "✗ set EXT=<slug>"; exit 1; fi
	@if [ -z "$$DISPLAY" ] || [ ! -S /tmp/.X11-unix/X$${DISPLAY#:} ]; then \
		echo "✗ no X11 display in the container — recreate it from a desktop session: docker rm -f $(CONTAINER_NAME), then make in-docker-try EXT=$(EXT)"; exit 1; fi
	@pnpm --filter "./extensions/$(EXT)" exec playwright install --with-deps --no-shell chromium >/dev/null
	@if [ -n "$(DEV)" ]; then \
		rm -rf "extensions/$(EXT)/.output/chrome-mv3-dev"; \
		pnpm --filter "./extensions/$(EXT)" dev > /tmp/tabmill-dev-$(EXT).log 2>&1 & dev=$$!; \
		for i in $$(seq 1 60); do [ -f "extensions/$(EXT)/.output/chrome-mv3-dev/manifest.json" ] && break; sleep 1; done; \
		echo "✓ dev server running (hot reload)"; \
		pnpm --filter "./extensions/$(EXT)" try "$$PWD/extensions/$(EXT)/.output/chrome-mv3-dev" "$(TRY_PROFILE)-dev" "$(URL)"; \
		kill $$dev 2>/dev/null; \
	else \
		pnpm --filter "./extensions/$(EXT)" build >/dev/null && \
		pnpm --filter "./extensions/$(EXT)" try "$$PWD/extensions/$(EXT)/.output/chrome-mv3" "$(TRY_PROFILE)" "$(URL)"; \
	fi

typecheck: deps
	@pnpm -r --if-present --filter "./extensions/$(or $(EXT),*)" typecheck
	@echo "✓ Typecheck complete"

lint: deps
	@pnpm -r --if-present --filter "./extensions/$(or $(EXT),*)" lint
	@echo "✓ Lint complete"

zip: deps
	@pnpm -r --filter "./extensions/$(or $(EXT),*)" zip
	@echo "✓ Zip complete"

dev: deps
	@if [ -z "$(EXT)" ]; then echo "✗ set EXT=<slug>"; exit 1; fi
	@pnpm --filter "./extensions/$(EXT)" dev

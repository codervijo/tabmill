# Generated by `tabmill settings init` from tabmill/ci (tool code — edit there, not here).
# Typecheck, lint, test, build every extension; on a v* tag also build release zips.
# Publishing is NOT done here — it stays a manual, attended step.
#
# The workspace and tabmill are checked out in the same relative layout as on the
# operator's machine, because pnpm-workspace.yaml links tabmill's packages by relative path
# (ADR-0006/0007). tabmill is private: TABMILL_PAT = fine-grained token, Contents read-only.
name: extensions

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          path: {{workspace_in_mount}}
      - id: ref
        run: echo "ref=$(cat {{workspace_in_mount}}/.tabmill-ref)" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@v7
        with:
          repository: {{tool_repo}}
          ref: ${{ steps.ref.outputs.ref }}
          path: {{tool_in_mount}}
          token: ${{ secrets.TABMILL_PAT }}
      - uses: pnpm/action-setup@v6
        with:
          version: 12
      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: pnpm
          cache-dependency-path: {{workspace_in_mount}}/pnpm-lock.yaml
      - working-directory: {{workspace_in_mount}}
        run: |
          pnpm install --frozen-lockfile
          pnpm -r --if-present --filter "./extensions/*" typecheck
          pnpm -r --if-present --filter "./extensions/*" lint
          pnpm -r --if-present --filter "./extensions/*" test
          pnpm -r --filter "./extensions/*" build
      - if: startsWith(github.ref, 'refs/tags/v')
        working-directory: {{workspace_in_mount}}
        run: pnpm -r --filter "./extensions/*" zip
      - if: startsWith(github.ref, 'refs/tags/v')
        uses: actions/upload-artifact@v7  # latest v7.0.1 (checked 2026-10-03)
        with:
          name: release-zips
          path: {{workspace_in_mount}}/extensions/*/.output/*.zip

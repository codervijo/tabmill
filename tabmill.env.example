# Copy to tabmill.env (gitignored), or use `tabmill settings apikeys set`. CWS API v2 credentials.
# Publisher ID: Developer Dashboard → Publisher → Settings.
CWS_PUBLISHER_ID=
# Preferred: service account JSON key (create with no roles; add its email in Dashboard → Account).
CWS_SA_KEY_FILE=
# Or OAuth client + refresh token (see skills/tabmill-release/reference.md § Auth).
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
